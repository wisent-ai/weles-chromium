From 35d835833b5eae585db14e656a4b657558ca8e90 Mon Sep 17 00:00:00 2001
From: lbartoszcze <lgb2127@columbia.edu>
Date: Tue, 21 Apr 2026 10:04:58 -0700
Subject: [PATCH 3/7] weles: remove unreachable code in PrepareForAuthRestart

The earlier weles patch made the reconnect-on-407 path unconditional but
left the 'drain body / reuse socket' branch in place. With Werror
-Wunreachable-code on Linux that compile stops the build at step 9594.
Deleting the dead block is the minimal correct fix.
---
 net/http/http_proxy_client_socket.cc | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/net/http/http_proxy_client_socket.cc b/net/http/http_proxy_client_socket.cc
index 25650f72a2a9a..5a50ab9051ca9 100644
--- a/net/http/http_proxy_client_socket.cc
+++ b/net/http/http_proxy_client_socket.cc
@@ -216,15 +216,6 @@ int HttpProxyClientSocket::PrepareForAuthRestart() {
   // a higher layer which opens a new socket and includes Proxy-Authorization.
   socket_->Disconnect();
   return ERR_UNABLE_TO_REUSE_CONNECTION_FOR_PROXY_AUTH;
-
-  // If the auth request had a body, need to drain it before reusing the socket.
-  if (!http_stream_parser_->IsResponseBodyComplete()) {
-    next_state_ = STATE_DRAIN_BODY;
-    drain_buf_ = base::MakeRefCounted<IOBufferWithSize>(kDrainBodyBufferSize);
-    return OK;
-  }
-
-  return DidDrainBodyForAuthRestart();
 }
 
 int HttpProxyClientSocket::DidDrainBodyForAuthRestart() {
