From d6d2c89d63f6a5bd4a921aa7392887bc4f3dcf45 Mon Sep 17 00:00:00 2001
From: lbartoszcze <lukasz@wisent.ai>
Date: Tue, 2 Jun 2026 08:43:22 -0700
Subject: [PATCH 7/7] weles: mirror release-channel behavior for 3
 dcheck_always_on aborts

Our build runs dcheck_always_on, so DCHECKs that release Chromium compiles
out become FATAL aborts. Three fire during real automation and take down
the browser, where stock release chrome silently continues:

- AssertBlockingAllowed: TikTok captcha WASM / V8 optimizer do sync I/O in
  non-blocking task traits.
- TabStatsDataStore::OnWindowRemoved: TikTok verify SDK opens+closes popup
  iframes faster than the window counter tracks, underflowing past 0.
- ToV8ContextMaybeEmpty: Arkose/GitHub nav sequences transiently point the
  v8 context at a detached frame before the new context attaches.

Each is neutralized to match release-channel behavior, not bypassed blindly.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 base/threading/thread_restrictions.cc                | 12 +++++-------
 .../metrics/tab_stats/tab_stats_data_store.cc        |  6 +++++-
 .../renderer/bindings/core/v8/v8_binding_for_core.cc |  7 ++++++-
 3 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/base/threading/thread_restrictions.cc b/base/threading/thread_restrictions.cc
index c5f793b60a1cb..271ba1bb0365e 100644
--- a/base/threading/thread_restrictions.cc
+++ b/base/threading/thread_restrictions.cc
@@ -59,13 +59,11 @@ constinit thread_local BooleanWithOptionalStack
 }  // namespace
 
 void AssertBlockingAllowed() {
-  DUMP_OR_DCHECK(!tls_blocking_disallowed)
-      << "Function marked as blocking was called from a scope that disallows "
-         "blocking! If this task is running inside the ThreadPool, it needs "
-         "to have MayBlock() in its TaskTraits. Otherwise, consider making "
-         "this blocking work asynchronous or, as a last resort, you may use "
-         "ScopedAllowBlocking (see its documentation for best practices).\n"
-      << "tls_blocking_disallowed " << tls_blocking_disallowed;
+  // weles: release Chromium silently allows this, dcheck_always_on aborts.
+  // TikTok's captcha WASM and some V8 optimizer paths do synchronous I/O
+  // inside non-blocking task traits and take down the browser. Mirror
+  // release-channel behavior by skipping the DCHECK body.
+  // Original: DUMP_OR_DCHECK(!tls_blocking_disallowed) << ...;
 }
 
 void AssertBlockingDisallowedForTesting() {
diff --git a/chrome/browser/metrics/tab_stats/tab_stats_data_store.cc b/chrome/browser/metrics/tab_stats/tab_stats_data_store.cc
index 35fccb7b06a62..248a6dbcbceb3 100644
--- a/chrome/browser/metrics/tab_stats/tab_stats_data_store.cc
+++ b/chrome/browser/metrics/tab_stats/tab_stats_data_store.cc
@@ -81,7 +81,11 @@ void TabStatsDataStore::OnWindowAdded() {
 
 void TabStatsDataStore::OnWindowRemoved() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
-  DCHECK_GT(tab_stats_.window_count, 0U);
+  // weles: TikTok's captcha/verify SDK opens popup iframes then closes them
+  // faster than this counter tracks, producing OnWindowRemoved with count=0.
+  // Release Chromium silently underflows; dcheck_always_on aborts the browser
+  // with FATAL tab_stats_data_store.cc:84. Mirror release behavior.
+  if (tab_stats_.window_count == 0U) return;
   tab_stats_.window_count--;
 }
 
diff --git a/third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.cc b/third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.cc
index 82b9404318262..fc8330f78bbaa 100644
--- a/third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.cc
+++ b/third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.cc
@@ -764,7 +764,12 @@ v8::Local<v8::Context> ToV8ContextMaybeEmpty(LocalFrame* frame,
   v8::Local<v8::Context> context =
       frame->WindowProxyMaybeUninitialized(world)->ContextIfInitialized();
 
-  DCHECK(context.IsEmpty() || frame == ToLocalFrameIfNotDetached(context));
+  // weles patch: DCHECK fires under some Arkose/GitHub navigation sequences
+  // where the v8 context transiently points to a detached frame before the
+  // new context finishes attaching. Release Chrome mirrors this through a
+  // frame == ToLocalFrameIfNotDetached() early-return in the same code path;
+  // our dcheck_always_on build aborts here instead. Neutralize via EAT.
+  EAT_CHECK_STREAM_PARAMS(context.IsEmpty() || frame == ToLocalFrameIfNotDetached(context));
   return context;
 }
 
