 namespace {
 
+// ----- Weles fingerprint config (HTTP-side) -----
+//
+// embedder_support cannot include the singleton from
+// third_party/blink/renderer/platform/ because of layering: components/
+// is only allowed to depend on third_party/blink/public. So we re-parse
+// the same JSON file the renderer-side singleton reads. The renderer
+// path stays canonical; this is a passive HTTP-header consumer that only
+// touches the client-hints subset.
+
+struct WelesUaConfig {
+  std::optional<std::string> user_agent;
+  std::optional<std::string> ch_platform;
+  std::optional<std::string> ch_platform_version;
+  std::optional<std::string> ch_architecture;
+  std::optional<std::string> ch_bitness;
+  std::optional<std::string> ch_model;
+  std::optional<bool> ch_mobile;
+  std::optional<bool> ch_wow64;
+  std::optional<std::string> ch_full_version;
+  std::vector<std::pair<std::string, std::string>> ch_brand_list;
+  std::vector<std::pair<std::string, std::string>>
+      ch_brand_full_version_list;
+};
+
+void LoadWelesBrandList(
+    const base::DictValue& dict, std::string_view key,
+    std::vector<std::pair<std::string, std::string>>* out) {
+  const base::ListValue* list = dict.FindList(key);
+  if (!list)
+    return;
+  for (const base::Value& v : *list) {
+    const base::DictValue* d = v.GetIfDict();
+    if (!d)
+      continue;
+    const std::string* brand = d->FindString("brand");
+    const std::string* version = d->FindString("version");
+    if (brand && version)
+      out->emplace_back(*brand, *version);
+  }
+}
+
+const WelesUaConfig* GetWelesUaConfig() {
+  static base::NoDestructor<std::unique_ptr<WelesUaConfig>> instance([]() {
+    std::unique_ptr<WelesUaConfig> cfg;
+    const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    if (!cl || !cl->HasSwitch(blink::switches::kWelesFingerprint))
+      return cfg;
+    std::string value =
+        cl->GetSwitchValueASCII(blink::switches::kWelesFingerprint);
+    if (value.empty())
+      return cfg;
+    std::string contents;
+    if (value[0] == '{') {
+      contents = value;
+    } else {
+      if (!base::ReadFileToString(base::FilePath(value), &contents))
+        return cfg;
+    }
+    std::optional<base::DictValue> dict =
+        base::JSONReader::ReadDict(contents, 0);
+    if (!dict)
+      return cfg;
+    cfg = std::make_unique<WelesUaConfig>();
+    if (const base::DictValue* nav = dict->FindDict("navigator")) {
+      if (const std::string* s = nav->FindString("userAgent"))
+        cfg->user_agent = *s;
+    }
+    if (const base::DictValue* ch = dict->FindDict("clientHints")) {
+      if (const std::string* s = ch->FindString("platform"))
+        cfg->ch_platform = *s;
+      if (const std::string* s = ch->FindString("platformVersion"))
+        cfg->ch_platform_version = *s;
+      if (const std::string* s = ch->FindString("architecture"))
+        cfg->ch_architecture = *s;
+      if (const std::string* s = ch->FindString("bitness"))
+        cfg->ch_bitness = *s;
+      if (const std::string* s = ch->FindString("model"))
+        cfg->ch_model = *s;
+      if (std::optional<bool> b = ch->FindBool("mobile"))
+        cfg->ch_mobile = b;
+      if (std::optional<bool> b = ch->FindBool("wow64"))
+        cfg->ch_wow64 = b;
+      if (const std::string* s = ch->FindString("fullVersion"))
+        cfg->ch_full_version = *s;
+      LoadWelesBrandList(*ch, "brandList", &cfg->ch_brand_list);
+      LoadWelesBrandList(*ch, "brandFullVersionList",
+                         &cfg->ch_brand_full_version_list);
+    }
+    return cfg;
+  }());
+  return instance->get();
+}
+
