diff --git a/third_party/blink/renderer/platform/weles_fingerprint_config.cc b/third_party/blink/renderer/platform/weles_fingerprint_config.cc
new file mode 100644
index 0000000000000..a84b8c3d7a4f9
--- /dev/null
+++ b/third_party/blink/renderer/platform/weles_fingerprint_config.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The Wisent Authors.
+
+#include "third_party/blink/renderer/platform/weles_fingerprint_config.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "third_party/blink/public/common/switches.h"
+
+namespace blink {
+namespace {
+
+// --- Small helpers that turn DictValue lookups into the
+//     std::optional<T> fields on WelesFingerprintConfig. They all
+//     silently ignore missing/wrong-typed fields so a partial config
+//     is valid; missing fields just fall through to stock behaviour.
+
+std::optional<std::string> GetString(const base::DictValue& d,
+                                     std::string_view key) {
+  const std::string* v = d.FindString(key);
+  return v ? std::optional<std::string>(*v) : std::nullopt;
+}
+
+std::optional<int32_t> GetInt(const base::DictValue& d,
+                              std::string_view key) {
+  std::optional<int> v = d.FindInt(key);
+  return v ? std::optional<int32_t>(static_cast<int32_t>(*v)) : std::nullopt;
+}
+
+std::optional<uint32_t> GetUInt(const base::DictValue& d,
+                                std::string_view key) {
+  std::optional<int> v = d.FindInt(key);
+  if (!v || *v < 0)
+    return std::nullopt;
+  return static_cast<uint32_t>(*v);
+}
+
+std::optional<uint64_t> GetUInt64(const base::DictValue& d,
+                                  std::string_view key) {
+  // JSON numbers come through as double; cast through int64 first.
+  std::optional<double> v = d.FindDouble(key);
+  if (!v || *v < 0)
+    return std::nullopt;
+  return static_cast<uint64_t>(*v);
+}
+
+std::optional<float> GetFloat(const base::DictValue& d,
+                              std::string_view key) {
+  std::optional<double> v = d.FindDouble(key);
+  return v ? std::optional<float>(static_cast<float>(*v)) : std::nullopt;
+}
+
+std::optional<bool> GetBool(const base::DictValue& d,
+                            std::string_view key) {
+  std::optional<bool> v = d.FindBool(key);
+  return v ? std::optional<bool>(*v) : std::nullopt;
+}
+
+std::optional<std::vector<std::string>> GetStringList(
+    const base::DictValue& d, std::string_view key) {
+  const base::ListValue* list = d.FindList(key);
+  if (!list)
+    return std::nullopt;
+  std::vector<std::string> out;
+  for (const base::Value& v : *list) {
+    if (const std::string* s = v.GetIfString())
+      out.push_back(*s);
+  }
+  return out;
+}
+
+std::optional<std::vector<WelesBrandVersion>> GetBrandList(
+    const base::DictValue& d, std::string_view key) {
+  const base::ListValue* list = d.FindList(key);
+  if (!list)
+    return std::nullopt;
+  std::vector<WelesBrandVersion> out;
+  for (const base::Value& v : *list) {
+    const base::DictValue* dict = v.GetIfDict();
+    if (!dict)
+      continue;
+    const std::string* brand = dict->FindString("brand");
+    const std::string* version = dict->FindString("version");
+    if (!brand || !version)
+      continue;
+    out.push_back({*brand, *version});
+  }
+  return out;
+}
+
+// Loads and parses --weles-fingerprint=<json-or-path>. The value is
+// either inline JSON (starts with '{') or a file path. Returns nullopt
+// if the switch isn't set or the JSON is malformed.
+std::optional<base::DictValue> LoadConfigDict() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (!cl || !cl->HasSwitch(switches::kWelesFingerprint))
+    return std::nullopt;
+  std::string value =
+      cl->GetSwitchValueASCII(switches::kWelesFingerprint);
+  if (value.empty())
+    return std::nullopt;
+  // Inline JSON: parse directly.
+  if (value[0] == '{')
+    return base::JSONReader::ReadDict(value, 0);
+  // Otherwise treat as file path.
+  std::string contents;
+  if (!base::ReadFileToString(base::FilePath(value), &contents))
+    return std::nullopt;
+  return base::JSONReader::ReadDict(contents, 0);
+}
+
+// Build the singleton from the JSON file. Returns nullptr if the switch
+// isn't set or the file can't be parsed; either way, every patched call
+// site falls through to stock chromium behaviour.
+WelesFingerprintConfig* BuildConfig() {
+  std::optional<base::DictValue> dict = LoadConfigDict();
+  if (!dict)
+    return nullptr;
+  auto cfg = std::make_unique<WelesFingerprintConfig>();
+  if (const base::DictValue* nav = dict->FindDict("navigator")) {
+    cfg->navigator_user_agent = GetString(*nav, "userAgent");
+    cfg->navigator_platform = GetString(*nav, "platform");
+    cfg->navigator_vendor = GetString(*nav, "vendor");
+    cfg->navigator_product_sub = GetString(*nav, "productSub");
+    cfg->navigator_language = GetString(*nav, "language");
+    cfg->navigator_languages = GetStringList(*nav, "languages");
+    cfg->navigator_hardware_concurrency =
+        GetUInt(*nav, "hardwareConcurrency");
+    cfg->navigator_device_memory = GetFloat(*nav, "deviceMemory");
+    cfg->navigator_do_not_track = GetString(*nav, "doNotTrack");
+  }
+  if (const base::DictValue* scr = dict->FindDict("screen")) {
+    cfg->screen_width = GetInt(*scr, "width");
+    cfg->screen_height = GetInt(*scr, "height");
+    cfg->screen_avail_width = GetInt(*scr, "availWidth");
+    cfg->screen_avail_height = GetInt(*scr, "availHeight");
+    cfg->screen_color_depth = GetUInt(*scr, "colorDepth");
+  }
+  if (const base::DictValue* gl = dict->FindDict("webgl")) {
+    cfg->webgl_unmasked_vendor = GetString(*gl, "unmaskedVendor");
+    cfg->webgl_unmasked_renderer = GetString(*gl, "unmaskedRenderer");
+  }
+  if (const base::DictValue* canvas = dict->FindDict("canvas")) {
+    cfg->canvas_seed = GetUInt64(*canvas, "noiseSeed");
+    if (!cfg->canvas_seed) cfg->canvas_seed = GetUInt64(*canvas, "seed");
+  }
+  if (const base::DictValue* audio = dict->FindDict("audio")) {
+    cfg->audio_seed = GetUInt64(*audio, "noiseSeed");
+    if (!cfg->audio_seed) cfg->audio_seed = GetUInt64(*audio, "seed");
+  }
+  cfg->locale = GetString(*dict, "locale");
+  cfg->webrtc_ip = GetString(*dict, "webrtcIp");
+  if (const base::DictValue* ch = dict->FindDict("clientHints")) {
+    cfg->ch_platform = GetString(*ch, "platform");
+    cfg->ch_platform_version = GetString(*ch, "platformVersion");
+    cfg->ch_architecture = GetString(*ch, "architecture");
+    cfg->ch_bitness = GetString(*ch, "bitness");
+    cfg->ch_model = GetString(*ch, "model");
+    cfg->ch_mobile = GetBool(*ch, "mobile");
+    cfg->ch_wow64 = GetBool(*ch, "wow64");
+    cfg->ch_full_version = GetString(*ch, "fullVersion");
+    cfg->ch_brand_list = GetBrandList(*ch, "brandList");
+    cfg->ch_brand_full_version_list =
+        GetBrandList(*ch, "brandFullVersionList");
+  }
+  return cfg.release();
+}
+
+}  // namespace
+
+// static
+const WelesFingerprintConfig* WelesFingerprintConfig::Get() {
+  // Singleton lives for the entire process; the leak is intentional.
+  static const WelesFingerprintConfig* instance = BuildConfig();
+  return instance;
+}
+
+WelesFingerprintConfig::WelesFingerprintConfig() = default;
+WelesFingerprintConfig::~WelesFingerprintConfig() = default;
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/platform/weles_fingerprint_config.h b/third_party/blink/renderer/platform/weles_fingerprint_config.h
new file mode 100644
index 0000000000000..79abb42036aed
--- /dev/null
+++ b/third_party/blink/renderer/platform/weles_fingerprint_config.h
@@ -0,0 +1,101 @@
+// Copyright 2026 The Wisent Authors.
+//
+// Process-wide singleton holding spoofed fingerprint values read from a
+// JSON file pointed at by --weles-fingerprint=<path>. When the switch
+// is unset, Get() returns nullptr and every patched call site falls
+// through to stock Chromium behaviour, so an unflagged binary is a
+// drop-in replacement for upstream chrome.
+//
+// The schema mirrors weles.fingerprint.to_cpp_config (Python). Adding
+// a new spoofable property is a 3-step change:
+//   1) add the std::optional field below,
+//   2) parse it in the .cc constructor,
+//   3) early-return from the corresponding blink getter.
+//
+// Lives in third_party/blink/renderer/platform/ so both core/ and
+// modules/ can include it without DEPS violations.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_WELES_FINGERPRINT_CONFIG_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_WELES_FINGERPRINT_CONFIG_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+
+struct PLATFORM_EXPORT WelesBrandVersion {
+  std::string brand;
+  std::string version;
+};
+
+class PLATFORM_EXPORT WelesFingerprintConfig {
+ public:
+  // Returns the singleton if --weles-fingerprint=<path> was passed AND
+  // the file parsed successfully; nullptr otherwise. Thread-safe.
+  static const WelesFingerprintConfig* Get();
+
+  WelesFingerprintConfig(const WelesFingerprintConfig&) = delete;
+  WelesFingerprintConfig& operator=(const WelesFingerprintConfig&) = delete;
+
+  // ----- navigator.* -----
+  std::optional<std::string> navigator_user_agent;
+  std::optional<std::string> navigator_platform;
+  std::optional<std::string> navigator_vendor;
+  std::optional<std::string> navigator_product_sub;
+  std::optional<std::string> navigator_language;
+  std::optional<std::vector<std::string>> navigator_languages;
+  std::optional<uint32_t> navigator_hardware_concurrency;
+  std::optional<float> navigator_device_memory;
+  std::optional<std::string> navigator_do_not_track;
+
+  // ----- screen.* (CSS pixels) -----
+  std::optional<int32_t> screen_width;
+  std::optional<int32_t> screen_height;
+  std::optional<int32_t> screen_avail_width;
+  std::optional<int32_t> screen_avail_height;
+  std::optional<uint32_t> screen_color_depth;
+
+  // ----- WebGL UNMASKED_* -----
+  std::optional<std::string> webgl_unmasked_vendor;
+  std::optional<std::string> webgl_unmasked_renderer;
+
+  // ----- canvas / audio noise seeds -----
+  // Pixel/sample noise is deterministic per seed so repeated reads
+  // hash to the same value within a session.
+  std::optional<uint64_t> canvas_seed;
+  std::optional<uint64_t> audio_seed;
+
+  // ----- locale (Intl, Date, etc.) -----
+  std::optional<std::string> locale;
+
+  // ----- WebRTC IP override -----
+  // When set, all host/srflx ICE candidate IPs are replaced with this value
+  // so that the real machine IP is never leaked via WebRTC.
+  std::optional<std::string> webrtc_ip;
+
+  // ----- HTTP client hints (sec-ch-ua-*) -----
+  std::optional<std::string> ch_platform;
+  std::optional<std::string> ch_platform_version;
+  std::optional<std::string> ch_architecture;
+  std::optional<std::string> ch_bitness;
+  std::optional<std::string> ch_model;
+  std::optional<bool> ch_mobile;
+  std::optional<bool> ch_wow64;
+  std::optional<std::string> ch_full_version;
+  std::optional<std::vector<WelesBrandVersion>> ch_brand_list;
+  std::optional<std::vector<WelesBrandVersion>> ch_brand_full_version_list;
+
+  // The constructor and destructor are public so std::unique_ptr and
+  // base::NoDestructor can manage instances. The deleted copy operations
+  // above keep callers from accidentally duplicating the singleton.
+  WelesFingerprintConfig();
+  ~WelesFingerprintConfig();
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_WELES_FINGERPRINT_CONFIG_H_
