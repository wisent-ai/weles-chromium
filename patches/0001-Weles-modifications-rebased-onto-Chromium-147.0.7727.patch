+void AudioBuffer::ApplyWelesAudioNoiseIfNeeded(unsigned channel_index) {
+  auto* cfg = WelesFingerprintConfig::Get();
+  if (!cfg || !cfg->audio_seed) {
+    return;
+  }
+  if (noise_applied_.size() < channels_.size()) {
+    // WTF::Vector::resize only takes a size; new entries are
+    // value-initialized, which for `bool` means `false`.
+    noise_applied_.resize(channels_.size());
+  }
+  if (noise_applied_[channel_index]) {
+    return;
+  }
+  DOMFloat32Array* arr = channels_[channel_index].Get();
+  if (!arr) {
+    return;
+  }
+  base::span<float> data = arr->AsSpan();
+  // SplitMix64 step inline — same constants as the canvas helper. Yields
+  // a deterministic float in [-1, 1] range, scaled to ~1e-7 magnitude so
+  // it's well below any human-audible threshold but detectable by
+  // fingerprint hashes that sum the float bits.
+  uint64_t seed = *cfg->audio_seed;
+  for (size_t i = 0; i < data.size(); ++i) {
+    uint64_t z = seed ^ (static_cast<uint64_t>(channel_index) << 40) ^
+                 static_cast<uint64_t>(i);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    // Map to [-1, 1] then scale to 1e-7.
+    double r = (static_cast<double>(z) / static_cast<double>(UINT64_MAX)) *
+                   2.0 - 1.0;
+    data[i] += static_cast<float>(r * 1e-7);
+  }
+  noise_applied_[channel_index] = true;
+}
