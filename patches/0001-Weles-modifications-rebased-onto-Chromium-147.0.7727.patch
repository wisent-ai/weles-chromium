+// least-significant bit of one channel flipped on ~25% of pixels chosen
+// deterministically by the seed. The returned SkData backs the new
+// pixmap and must outlive it; the caller holds it via the unique_ptr.
+struct NoisedPixmap {
+  SkPixmap pixmap;
+  sk_sp<SkData> backing;
+};
+
+NoisedPixmap NoiseCanvasPixmap(const SkPixmap& src, uint64_t seed) {
+  const SkImageInfo& info = src.info();
+  const size_t row_bytes = src.rowBytes();
+  const size_t total_bytes = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(total_bytes) || total_bytes == 0)
+    return {SkPixmap(), nullptr};
+
+  sk_sp<SkData> data = SkData::MakeUninitialized(total_bytes);
+  std::memcpy(data->writable_data(), src.addr(), total_bytes);
+
+  const SkColorType ct = info.colorType();
+  const int bpp = info.bytesPerPixel();
+  // Only mess with 8-bit-per-channel RGBA/BGRA — anything else (e.g. F16)
+  // would need different math, and the canvas API path is always 8888.
+  if ((ct == kRGBA_8888_SkColorType || ct == kBGRA_8888_SkColorType) &&
+      bpp == 4) {
