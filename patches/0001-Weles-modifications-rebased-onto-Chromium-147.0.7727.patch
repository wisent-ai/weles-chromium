@@ -671,6 +789,41 @@ blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
   metadata.bitness = GetCpuBitness();
   metadata.wow64 = IsWoW64();
   metadata.platform_version = GetPlatformVersion();
+
+  // Weles overrides — keep at the end so all stock fields are populated
+  // first, then individually replaced by anything the JSON config sets.
+  // Per-field overrides only; null fields fall through to stock.
+  if (auto* cfg = GetWelesUaConfig()) {
+    if (cfg->ch_platform)
+      metadata.platform = *cfg->ch_platform;
+    if (cfg->ch_platform_version)
+      metadata.platform_version = *cfg->ch_platform_version;
+    if (cfg->ch_architecture)
+      metadata.architecture = *cfg->ch_architecture;
+    if (cfg->ch_bitness)
+      metadata.bitness = *cfg->ch_bitness;
+    if (cfg->ch_model)
+      metadata.model = *cfg->ch_model;
+    if (cfg->ch_mobile)
+      metadata.mobile = *cfg->ch_mobile;
+    if (cfg->ch_wow64)
+      metadata.wow64 = *cfg->ch_wow64;
+    if (cfg->ch_full_version)
+      metadata.full_version = *cfg->ch_full_version;
+    if (!cfg->ch_brand_list.empty()) {
+      metadata.brand_version_list.clear();
+      for (const auto& [brand, version] : cfg->ch_brand_list) {
+        metadata.brand_version_list.emplace_back(brand, version);
+      }
+    }
+    if (!cfg->ch_brand_full_version_list.empty()) {
+      metadata.brand_full_version_list.clear();
+      for (const auto& [brand, version] : cfg->ch_brand_full_version_list) {
+        metadata.brand_full_version_list.emplace_back(brand, version);
+      }
+    }
+  }
+
   return metadata;
 }
 
