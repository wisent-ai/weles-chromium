     browsers_and_subscriptions_.pop_back();
     std::erase(browsers_activation_order_, entry.browser.get());
 
+    // Notify observers (incl. GlobalBrowserCollection) before the Browser
+    // is destroyed, otherwise the global collection keeps a dangling
+    // raw_ptr<BrowserWindowInterface> that SIGSEGVs later during metrics
