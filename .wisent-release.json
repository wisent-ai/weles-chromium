{
  "schema_version": 1,
  "product": "weles-chromium",
  "releases": true,
  "version_source": {
    "kind": "json",
    "path": "browser-capabilities.json",
    "pointer": "/upstreamVersion"
  },
  "inputs": {},
  "platforms": {
    "darwin-arm64": {
      "quality": [
        {
          "name": "fmt",
          "argv": ["bash", "release/quality.sh"],
          "kind": "format"
        }
      ],
      "build": {
        "argv": ["bash", "release/build.sh"]
      },
      "stage": {
        "stage/Chromium.app": "Chromium.app"
      },
      "runner_platform": "darwin-arm64"
    },
    "linux-amd64": {
      "quality": [
        {
          "name": "fmt",
          "argv": ["bash", "release/quality.sh"],
          "kind": "format"
        }
      ],
      "build": {
        "argv": ["bash", "release/build.sh"]
      },
      "stage": {
        "stage/chromium": "chromium"
      },
      "runner_platform": "linux-amd64"
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "browser-runtime",
      "platform": "darwin-arm64",
      "argv": ["bash", "release/install.sh"],
      "required": true,
      "target": { "product": "weles-chromium" }
    },
    {
      "name": "browser-runtime-linux",
      "platform": "linux-amd64",
      "argv": ["bash", "release/install.sh"],
      "required": true,
      "target": { "product": "weles-chromium" }
    }
  ]
}
